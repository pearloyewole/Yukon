# Frontend runtime API target for hosted deployments.
# Example: https://yukon-backend.example.com
VITE_API_BASE_URL=

# Frontend dev proxy target (used by Vite dev server).
VITE_DEV_BACKEND_URL=http://localhost:8787

# River aligner Python server (Vite proxies /aligner-api to this URL).
VITE_DEV_ALIGNER_URL=http://127.0.0.1:3000

# Optional: override timelapse image root (default: <repo>/data/timelapse).
# VITE_DATA_ROOT=/absolute/path/to/custom/timelapse/folders

# Set to "true" only when a compile backend is available.
# Keep false for static/no-backend hosting (like Vercel static deploy).
VITE_ENABLE_UPLOAD_PIPELINE=false
